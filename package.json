{
  "name": "ncr-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:production": "node tests/production-smoke.mjs",
    "test:regional-wiring": "node tests/regional-browser-wiring.mjs",
    "test:regional-drive": "node --import tsx tests/regional-drive.mjs",
    "test:visual": "node tests/visual-browser.mjs",
    "test:living": "node --import tsx tests/living-production.mjs",
    "test:living-wiring": "node tests/living-wiring.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/three": "0.186.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
